# ============================================================
# 安心伴 (anxinban) 后端 Spring Boot 环境变量配置模板
# ============================================================
# 使用方法:
#   1. 复制此文件为 .env
#   2. 填入真实的配置值
#   3. 启动时加载: export $(cat .env | xargs) && java -jar ...
#   或者在 IDE 中配置 EnvFile 插件自动加载
# ============================================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=anxinban
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# ---------- MQTT ----------
# MQTT 开关 (true/false)
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ---------- AI 服务 ----------
# 外部 AI 服务地址 (队长 Python 服务)，留空则走 Java fallback
AI_SERVICE_BASE_URL=

# ---------- DeepSeek (Flutter 端使用) ----------
# 在 Flutter 构建时通过 --dart-define 传入，不在此处配置
# flutter build apk --release --dart-define=DEEPSEEK_API_KEY=sk-xxx
