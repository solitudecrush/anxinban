# ============================================================
# 安心伴 Flutter 前端构建参数配置模板
# ============================================================
# 这些值在 Flutter 构建时通过 --dart-define 传入，不会打包进代码。
#
# 使用方法:
#   1. 复制此文件为 .env
#   2. 填入真实值
#   3. source .env && flutter build apk --release \
#        --dart-define=DEEPSEEK_API_KEY=$DEEPSEEK_API_KEY \
#        --dart-define=API_BASE=$API_BASE \
#        --dart-define=AMAP_ANDROID_KEY=$AMAP_ANDROID_KEY
# ============================================================

# DeepSeek API Key (用于 AI 健康分析)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 后端 API 服务器地址 (生产环境云服务器 IP 或域名)
API_BASE=http://your-server-ip:8080

# 高德地图 Android Key
AMAP_ANDROID_KEY=your-amap-android-key
